  "narrative": {
    "northStar": "Powder Blue Product Lookbook",
    "overview": "Broad powder blue surfaces give the approved product drafts room to be understood. Ink-blue Korean typography, white information areas, and pale rose story sections make the site calm and direct. The existing handwritten face and bunny carry the personal voice of the letter.\n\nThis records the implemented 2026-10-25 homepage renewal and shared tokens. Existing article routes inherit the shared colors, type, navigation, and controls; their article component layouts remain intact. The exported letter retains its own approved cream-and-green palette. Mobbin references informed composition, not copied assets or claims.",
    "keyCharacteristics": [
      "Large, uninterrupted product scenes and clear Korean headings.",
      "Flat navigation, filled actions, and restrained hairline divisions.",
      "Handwriting and tactile paper reserved for the letter experience.",
      "Original logo geometry, product drafts, bunny artwork, and fonts preserved."
    ],
    "rules": [
      {
        "name": "The Asset Fidelity Rule",
        "body": "Keep the original product and bunny image bytes and approved logo paths; interface color changes must not recolor the printed packaging or exported letter by accident.",
        "section": "colors"
      },
      {
        "name": "The Paper Depth Rule",
        "body": "Use shadows to distinguish physical letter paper or transient feedback; broad product and information sections stay flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the current CSS token names and the existing Pretendard and Nanum Pen font loading.",
      "Do keep product images, the note, and draft disclosures in separate readable layout areas.",
      "Do preserve original logo geometry, approved asset bytes, official copy, URLs, and local letter data.",
      "Do preserve the letter preview/export geometry and its bounded cream-and-green palette.",
      "Do check desktop, 390px mobile, 320px narrow layouts, keyboard focus, and reduced motion when changing these patterns."
    ],
    "donts": [
      "Don't copy Mobbin imagery, brand copy, or code into the site; use the recorded composition principles.",
      "Don't promote a product draft or development direction into a confirmed specification, efficacy claim, price, or launch date.",
      "Don't turn broad sections into floating cards or put the letter note over the product artwork.",
      "Don't replace the original logo, product drafts, bunny, or fonts with new raster assets.",
      "Don't spread homepage composition into existing article layouts without a separate scoped change."
    ]
  }
