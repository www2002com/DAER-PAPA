# 이 파일을 .env로 복사해 값을 채웁니다. .env는 git에 올라가지 않습니다. 키를 채팅에 붙여넣지 마세요.
# 모델 ID는 기본값이 없습니다 — 각 서비스 문서에서 현재 이용 가능한 이름을 확인해 적습니다.

# Gemini — 레퍼런스 영상 역기획(01)과 이미지→영상(03)
GEMINI_API_KEY=
DP_GEMINI_MODEL=
# 영상 생성 경로: veo (models/{DP_VEO_MODEL}:predictLongRunning) 또는 omni (Interactions API)
# 참고: Gemini API의 Veo 3.1 프리뷰 모델은 2026-10-22 종료 예정으로 안내되어 있습니다.
DP_VIDEO_BACKEND=
DP_VEO_MODEL=
# DP_VEO_DURATION=8

# OpenAI — 장면 이미지(03)와 대본 교차 검증(02)
OPENAI_API_KEY=
DP_GPT_IMAGE_MODEL=
DP_GPT_REVIEW_MODEL=

# ElevenLabs — 한국어 내레이션 + 글자 단위 타임스탬프
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Instagram Graph API — @dearpapa.kr 프로페셔널 계정 (instagram_content_publish 권한), 오가닉 게시만
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=https://graph.facebook.com
# IG_GRAPH_VERSION=v23.0

# 선택
# DP_OUTPUTS_DIR=            실행 산출물 위치 (기본: automation/outputs)
# DP_FONT_DIR=               자막 글꼴 폴더 (기본: pretendard 패키지)
# DP_FONT_NAME=Pretendard
