{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/product",
      "destination": "/letter-all-in-one",
      "statusCode": 301
    },
    {
      "source": "/product/",
      "destination": "/letter-all-in-one",
      "statusCode": 301
    },
    {
      "source": "/product.html",
      "destination": "/letter-all-in-one",
      "statusCode": 301
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/llm.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/facts.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/answer.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/citation.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/schema.jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/fonts/pretendard/:version/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
