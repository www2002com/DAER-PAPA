{
  "name": "dearpapa-kr",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DEAR PAPA(디어파파) 공식 사이트 — 아빠의 매일에, 딸의 마음을.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run verify:preservation && npm run verify:icons",
    "start": "npx serve out",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "verify:preservation": "node scripts/verify-preservation.mjs",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "verify:icons": "node scripts/verify-brand-icons.mjs",
    "lastmod": "node scripts/update-lastmod.mjs",
    "test": "node scripts/run-tests.mjs",
    "prebuild": "node scripts/prepare-fonts.mjs && npm test"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
