# Claude — 기획서 생성, 레퍼런스 비전 분석, 장면 프롬프트, 생성 이미지 왜곡 검사
ANTHROPIC_API_KEY=
# DP_CLAUDE_MODEL=claude-opus-5-5

# fal.ai — 장면 이미지(텍스트→이미지)와 영상화(이미지→영상). 모델 ID는 첫 실행 전에 fal.ai에서 현재 이름을 확인하세요.
FAL_KEY=
# DP_IMAGE_MODEL=fal-ai/flux-pro/v1.1
# DP_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# ElevenLabs — 한국어 내레이션 + 글자 단위 타임스탬프
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Instagram Graph API — @dearpapa.kr 프로페셔널 계정 (instagram_content_publish 권한)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=https://graph.facebook.com
# IG_GRAPH_VERSION=v23.0

# 선택: 자막 글꼴 (기본: pretendard 패키지)
