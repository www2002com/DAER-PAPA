{
  "$schema_comment": "Page-specific sources for sitemap lastmod. Shared chrome is intentionally omitted so layout/header/footer/globals/menu edits do not bump every URL.",
  "omitShared": [
    "app/layout.tsx",
    "app/globals.css",
    "components/SiteHeader.tsx",
    "components/SiteFooter.tsx",
    "lib/menu.ts",
    "lib/preserved-site.json",
    "lib/preserved-metadata.ts",
    "vercel.json"
  ],
  "omitSharedNote": "lib/preserved-site.json holds factsBodyHtml and per-page metadata baselines; it is omitted as a global source because unrelated page baseline edits would bump every mapped URL. /about/facts tracks public/facts.json (and the facts route files) instead. After editing factsBodyHtml, also update public/facts.json or bump /about/facts in lib/lastmod.json when running scripts/update-lastmod.mjs.",
  "pages": {
    "/": [
      "app/page.tsx",
      "app/@structuredData/page.tsx",
      "components/home",
      "lib/facts.ts"
    ],
